@token=

POST http://localhost:8081/api/auth/register
Content-Type: application/json

{
    "username": "john_doe87",
    "password": "securePassword87",
    "email": "john87@example.com",
    "balance": 100.00
}

###

POST http://localhost:8081/api/auth/login
Content-Type: application/json

{
    "username": "john_doe87",
    "password": "securePassword87"
}



# ✅ Disables CSRF protection
# ✅ Disables CORS restrictions
# ✅ Permits all requests to auth endpoints
# ✅ Permits all other requests as wel

###

# Create a product (requires ADMIN role; set @token from login of an admin user)
POST http://localhost:8081/api/products
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "sku": "SKU-001",
    "name": "Sample Item",
    "description": "A thing to buy",
    "price": 19.99,
    "stock": 50,
    "category": "general"
}

###

# Pay for an order (user must own the order)
POST http://localhost:8081/api/payments
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "orderId": 2,
    "paymentMethod": "CARD",
    "providerReference": "demo-ref-123",
    "currency": "USD"
}

###

# Create an order (authenticated, owner-only)
POST http://localhost:8081/api/orders
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "userId": 1,
    "productId": 1,
    "quantity": 2
}

###

# Get my orders (uses authenticated principal)
GET http://localhost:8081/api/orders
Authorization: Bearer {{token}}

###

# Get a single order by id (enforces ownership)
GET http://localhost:8081/api/orders/1
Authorization: Bearer {{token}}

###

# Get orders for a user (enforces ownership)
GET http://localhost:8081/api/orders/user/1
Authorization: Bearer {{token}}

